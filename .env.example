# TX KPI Monitor - settings template. Copy to .env and fill in.
KPI_DB_PASSWORD=

KPI_DB_HOST=localhost
KPI_DB_PORT=5432
KPI_DB_NAME=tx_kpi
KPI_DB_USER=kpi_app

# Address the web app listens on. 127.0.0.1 = this PC only, 0.0.0.0 = whole network.
KPI_HOST=127.0.0.1
KPI_PORT=8000

# Folders (relative paths are inside the project folder)
KPI_INBOX_DIR=inbox
KPI_ARCHIVE_DIR=archive
KPI_FAILED_DIR=failed
KPI_REPORTS_DIR=reports

# Optional: fetch the KPI dump files from a server over SFTP (the same login as SSH).
# Leave KPI_SFTP_HOST empty to switch this off. The server is only read, never changed.
# An administrator can also set or change the server on the Imports page (Change server).
# Once saved there, those values are used and the KPI_SFTP_* lines below are ignored.
KPI_SFTP_HOST=
KPI_SFTP_PORT=22
KPI_SFTP_USER=
# Log in with a key file (recommended) or a password. Fill in one of the two.
KPI_SFTP_KEY_FILE=
KPI_SFTP_KEY_PASSPHRASE=
KPI_SFTP_PASSWORD=
# Folder on the server that holds the dump files, for example /home/prs/dump
KPI_SFTP_DIR=
# How often to check (minutes) and how many days back a routine check looks.
KPI_SFTP_MINUTES=5
KPI_SFTP_DAYS=2
